# Required
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Domain for HTTPS (Caddy auto-generates Let's Encrypt certs)
# Use "localhost" for dev (self-signed), your domain for prod
DOMAIN=localhost

# Examples:
# DOMAIN=api.toutim.app        → auto HTTPS with Let's Encrypt
# DOMAIN=localhost              → self-signed cert for dev
