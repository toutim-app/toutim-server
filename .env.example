# === Required ===
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Domain for HTTPS (Caddy auto-generates Let's Encrypt certs)
# Use "localhost" for dev (self-signed), your domain for prod
DOMAIN=localhost
# Examples:
# DOMAIN=api.toutim.app        → auto HTTPS with Let's Encrypt
# DOMAIN=localhost              → self-signed cert for dev

# === Server ===
# TOUTIM_PORT=8080
# TOUTIM_HOST=0.0.0.0
# TOUTIM_DATA_DIR=./data

# === Database ===
# TOUTIM_POOL_SIZE=100

# === SMTP (optional — enables email verification & password reset) ===
# Without SMTP, users are auto-verified at registration.
# TOUTIM_SMTP_HOST=smtp.example.com
# TOUTIM_SMTP_PORT=587
# TOUTIM_SMTP_USERNAME=your-smtp-username
# TOUTIM_SMTP_PASSWORD=your-smtp-password
# TOUTIM_SMTP_FROM_ADDRESS=noreply@toutim.app
# TOUTIM_SMTP_FROM_NAME=Toutim
# TOUTIM_SMTP_USE_TLS=false
# TOUTIM_SMTP_BASE_URL=https://toutim.app
